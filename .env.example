# Copy to .env.local only when setting up a real shared club.
# Local exploration needs no environment file.
BOOKCLUB_MODE=production
BOOKCLUB_ORIGIN=https://club.example
PORT=5055
BOOKCLUB_BIND_ADDRESS=127.0.0.1
DATABASE_URL=postgresql://replace-user:replace-password@replace-host:5432/replace-database?sslmode=verify-full
SUPABASE_URL=https://replace-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-project-publishable-key
SESSION_SECRET=replace-with-a-new-random-secret-at-least-32-characters-long
# Set after initialization, or recover with npm run setup -- status:
BOOKCLUB_OWNER_MEMBER_ID=
# Optional paid AI stays off by default:
BOOKCLUB_ENABLE_AI=no
# ANTHROPIC_API_KEY=
# BOOKCLUB_AI_MODEL=
# CRON_SECRET=

# Optional certificate authority file supplied by your database provider:
# BOOKCLUB_DATABASE_CA_CERT=private/database-ca.pem
